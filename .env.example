# HuggingFace — required for model download during Docker build or Tier-3 RunPod fallback
HUGGINGFACE_USERNAME=your-huggingface-username
HF_TOKEN=hf_your_token_here

# Docker Hub — optional, used by build/push scripts
DOCKER_USER=your-dockerhub-username
DOCKER_TOKEN=dckr_pat_your_token_here

# RunPod — optional, used by test_check_paths.py
RUNPOD_API_KEY=rpa_your_runpod_api_key
RUNPOD_ENDPOINT_ID=your-endpoint-id
